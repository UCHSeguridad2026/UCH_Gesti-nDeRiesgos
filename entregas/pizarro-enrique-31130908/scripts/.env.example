# Configuracion del script de notificacion de riesgos altos
#
# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO debe subirse al repositorio: contiene credenciales.
# El .gitignore de la entrega ya bloquea los archivos .env

# URL del webhook de Discord al que se envian las alertas
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXX

# Credenciales de la base de datos de SimpleRisk
# Se obtienen de includes/config.php dentro del contenedor
DB_PASSWORD=cambiar_por_la_password_real
DB_USER=simplerisk
DB_NAME=simplerisk

# Nombre del contenedor Docker de SimpleRisk
CONTENEDOR=simplerisk

# Score minimo a partir del cual se notifica un riesgo
UMBRAL=6
